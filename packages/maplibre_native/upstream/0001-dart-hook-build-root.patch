+/// Resolves what the pointer names to the install prefix for this build.
+///
+/// The pointer names either an install prefix, or a build root that holds one
+/// `<preset>/install` per configured preset, as `cmake --preset` lays them out
+/// under `build/`. A build root serves every target it has a preset for, so
+/// one Flutter build can bundle several Android ABIs, and switching between
+/// host and device builds needs no new pointer.
+Uri _localPrefix(Uri configured, BuildInput input) {
+  if (File.fromUri(_descriptorFile(configured)).existsSync()) {
+    return configured;
+  }
+  final preset = _resolvePreset(input);
+  final prefix = configured.resolve('${preset.name}/install/');
+  if (!File.fromUri(_descriptorFile(prefix)).existsSync()) {
+    throw StateError(
+      '${configured.toFilePath()} is neither an install prefix nor a build '
+      'root with a ${preset.name} install. Build that preset, or point '
+      '$installPrefixPointer at an install prefix.',
+    );
+  }
+  return prefix;
+}
