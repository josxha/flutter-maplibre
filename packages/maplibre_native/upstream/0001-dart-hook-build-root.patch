@@ -8,6 +8,80 @@ import 'package:test/test.dart';
 import '../hook/build.dart' as hook;
 
 void main() {
+  test('a build root serves each target from its preset', () async {
+    final temporary = await Directory.systemTemp.createTemp('native-hook-');
+    addTearDown(() => temporary.delete(recursive: true));
+    final packageRoot = temporary.uri.resolve('package/');
+    final buildRoot = temporary.uri.resolve('build/');
+    final pointer = File.fromUri(
+      packageRoot.resolve(hook.installPrefixPointer),
+    );
+    await pointer.parent.create(recursive: true);
+    await pointer.writeAsString(buildRoot.toFilePath());
+    // Without a backend user-define, Android takes its default, OpenGL ES,
+    // whose presets are named after EGL.
+    for (final architecture in ['arm64', 'x64']) {
+      final prefix = buildRoot.resolve('android-$architecture-egl/install/');
+      final descriptor = File.fromUri(
+        prefix.resolve('share/maplibre-native-c/artifact.json'),
+      );
+      await descriptor.parent.create(recursive: true);
+      await descriptor.writeAsString(
+        jsonEncode({
+          'targetPlatform': 'android-$architecture',
+          'renderBackend': 'opengl',
+        }),
+      );
+      final library = File.fromUri(
+        prefix.resolve('lib/libmaplibre-native-c.so'),
+      );
+      await library.parent.create(recursive: true);
+      await library.writeAsString(architecture);
+    }
+
+    Future<String> build(Architecture architecture, String name) async {
+      final output = temporary.uri.resolve('$name/');
+      final builder = BuildInputBuilder()
+        ..setupShared(
+          packageRoot: packageRoot,
+          packageName: 'maplibre_native_ffi',
+          outputDirectoryShared: temporary.uri.resolve('shared/'),
+          outputFile: output.resolve('output.json'),
+        )
+        ..setupBuildInput();
+      builder.config.setupBuild(linkingEnabled: false);
+      CodeAssetExtension(
+        targetArchitecture: architecture,
+        targetOS: OS.android,
+        linkModePreference: LinkModePreference.dynamic,
+        android: AndroidCodeConfig(targetNdkApi: 24),
+      ).setupBuildInput(builder);
+      final input = builder.build();
+      await Directory.fromUri(output).create(recursive: true);
+      final config = File.fromUri(temporary.uri.resolve('$name.json'));
+      await config.writeAsString(jsonEncode(input.json));
+      await hook.main(['--config=${config.path}']);
+      final result = BuildOutput(
+        jsonDecode(await File.fromUri(input.outputFile).readAsString())
+            as Map<String, Object?>,
+      );
+      return File.fromUri(result.assets.code.single.file!).readAsString();
+    }
+
+    expect(await build(Architecture.arm64, 'arm64'), 'arm64');
+    expect(await build(Architecture.x64, 'x64'), 'x64');
+    await expectLater(
+      build(Architecture.arm, 'arm'),
+      throwsA(
+        isA<StateError>().having(
+          (StateError error) => error.message,
+          'message',
+          contains('android-arm-egl'),
+        ),
+      ),
+    );
+  });
